// Jenkins pipeline for LogCrawler. In the job, set Script Path to .jenkins/Jenkinsfile.
//
// - Toolchain, Prepare, Lint, Test and Build run for every branch and pull request.
// - Publish and Release run only for a tag (v0.1.0 and so on): the Linux and Windows binaries are
//   archived and attached to a GitHub release.
//
// The Linux build links GTK 3 and WebKitGTK 4.1 through cgo, so the agent needs their development
// headers, installed from the distro (Debian: build-essential pkg-config libgtk-3-dev
// libwebkit2gtk-4.1-dev), plus git and mise on PATH. Go, Node, yarn, just and jq come from mise.toml;
// wails3 is installed by `just setup` into ~/.cache/logcrawler (it needs the headers too). The Windows .exe is cross-compiled on this
// Linux agent (Wails on Windows needs no cgo, so no mingw is required).
//
// Tag builds also need a "Secret text" credential `LogCrawler-github-token` with contents:write on
// KopyTKG/LogCrawler.

pipeline {
    agent any

    options {
        timestamps()
        disableConcurrentBuilds(abortPrevious: true)
        timeout(time: 30, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '30', artifactNumToKeepStr: '5'))
    }

    environment {
        CGO_ENABLED = '1'
        GOFLAGS = '-buildvcs=false'
        // Kept outside the workspace: a tag build gets a fresh workspace, and the Wails module is
        // large, so downloading it again every build is slow and fails on a flaky connection.
        GOCACHE = "${HOME}/.cache/logcrawler/go-build"
        GOPATH = "${HOME}/.cache/logcrawler/go"
        PATH = "${HOME}/.cache/logcrawler/go/bin:${PATH}"
    }

    stages {
        stage('Toolchain') {
            steps {
                // cgo needs a C compiler and the GTK/WebKit headers; fail with a clear message
                // instead of a cgo error halfway through the build.
                sh '''
                    command -v gcc >/dev/null || { echo "gcc missing: apt install build-essential"; exit 1; }
                    command -v pkg-config >/dev/null || { echo "pkg-config missing: apt install pkg-config"; exit 1; }
                    pkg-config --exists gtk+-3.0 || { echo "gtk3 headers missing: apt install libgtk-3-dev"; exit 1; }
                    pkg-config --exists webkit2gtk-4.1 || { echo "webkit2gtk headers missing: apt install libwebkit2gtk-4.1-dev"; exit 1; }
                '''
            }
        }

        stage('Prepare') {
            steps {
                // Trust this checkout's mise.toml, install what it pins, then wails3 and the
                // frontend dependencies.
                sh '''
                    mise trust --quiet "$WORKSPACE/mise.toml"
                    mise install
                    # Downloads (Go modules, yarn packages) fail now and then with a TLS timeout.
                    for attempt in 1 2 3; do
                        mise exec -- just setup && exit 0
                        echo "setup failed (attempt $attempt of 3)"; sleep 15
                    done
                    exit 1
                '''
                // package.json and yarn.lock must agree: installing may not change the lockfile.
                sh 'git diff --exit-code -- frontend/yarn.lock'
            }
        }

        stage('Lint') {
            steps {
                sh 'mise exec -- just lint'
            }
        }

        stage('Test') {
            steps {
                sh 'mise exec -- just test'
            }
        }

        stage('Build') {
            steps {
                sh 'mise exec -- just build build-windows'
                // go vet compiles main.go, which embeds frontend/dist, so it runs after the frontend build.
                sh 'mise exec -- just vet'
            }
        }

        stage('Publish') {
            when { buildingTag() }
            steps {
                sh '''
                    rm -rf dist && mkdir dist
                    cp bin/logcrawler dist/logcrawler-linux-x64
                    cp bin/logcrawler.exe dist/logcrawler-windows-x64.exe
                '''
                archiveArtifacts artifacts: 'dist/*', fingerprint: true
            }
        }

        stage('Release') {
            when { buildingTag() }
            steps {
                withCredentials([string(credentialsId: 'LogCrawler-github-token', variable: 'GH_TOKEN')]) {
                    sh 'mise exec -- ci/github-release.sh "$TAG_NAME" dist/logcrawler-linux-x64 dist/logcrawler-windows-x64.exe'
                }
            }
        }
    }
}
